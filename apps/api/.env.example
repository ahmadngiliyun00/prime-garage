# Copy to .env and fill in. Never commit .env.
NODE_ENV=production
PORT=3000
# 127.0.0.1 in production (behind Nginx). In development use 0.0.0.0 to test from a phone on the same Wi-Fi.
HOST=127.0.0.1
TRUST_PROXY=true

# MySQL 8 (aaPanel > Databases). Use a dedicated user limited to this database.
DATABASE_URL=mysql://pg_user:CHANGE_ME@127.0.0.1:3306/prime_garage
DATABASE_CONNECTION_LIMIT=10

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth client IDs allowed as ID token audience (web client and Android client), comma separated
GOOGLE_CLIENT_IDS=xxxxxxxx-web.apps.googleusercontent.com,xxxxxxxx-android.apps.googleusercontent.com

# Web app origin (same domain as the API in production, see ADR-008)
# GitHub login: create an OAuth App at https://github.com/settings/developers with
# Authorization callback URL = <API_PUBLIC_URL>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Only these GitHub usernames may sign in (comma separated). Empty = GitHub login refuses everyone.
GITHUB_ALLOWED_LOGINS=ahmadngiliyun00
# Public base URL of the API (same as the web origin in production, see ADR-008)
API_PUBLIC_URL=https://primegarage.ngiliyun.my.id
APP_WEB_URL=https://primegarage.ngiliyun.my.id
# Production web origin(s). In development, localhost and private network origins are always allowed.
CORS_ORIGINS=https://primegarage.ngiliyun.my.id

# Development only. MUST stay false in production (the API refuses to start otherwise).
AUTH_DEV_LOGIN_ENABLED=false

# Uploads, outside the code folder so they survive deploys
STORAGE_DIR=/www/wwwroot/primegarage.ngiliyun.my.id/storage

# Google Workspace SMTP (@ngiliyun.my.id). Use an App Password of the sending account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@ngiliyun.my.id
SMTP_PASS=CHANGE_ME_APP_PASSWORD
MAIL_FROM=PrimeGarage <noreply@ngiliyun.my.id>

# Optional: Expo access token if "Enhanced push security" is enabled in the Expo project
EXPO_ACCESS_TOKEN=

# Worker -> API realtime forwarding (same secret in both processes)
INTERNAL_API_URL=http://127.0.0.1:3000
INTERNAL_API_SECRET=CHANGE_ME_RANDOM_32_CHARS

# Daily reminders at 07:00 WIB. REMINDER_CRON is read in REMINDER_TZ (Asia/Jakarta = UTC+7).
REMINDER_CRON=0 7 * * *
REMINDER_TZ=Asia/Jakarta
