# Copy to .env (development). EXPO_PUBLIC_* values are embedded in the bundle: no secrets.
# Production web uses the same origin, so API URL can be empty on web builds served from primegarage.ngiliyun.my.id
EXPO_PUBLIC_API_URL=http://localhost:3000
# Google OAuth client IDs (Google Cloud Console > Credentials)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# Shows the developer login button (requires AUTH_DEV_LOGIN_ENABLED=true on the API). Keep false for production builds.
EXPO_PUBLIC_DEV_LOGIN=true
